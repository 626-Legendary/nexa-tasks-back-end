# 不要把 node_modules 打进镜像
node_modules/

# 不要把环境变量打进镜像
.env

# 不要把本地日志打进镜像
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / 编辑器文件
.vscode/
.idea/

# OS 系统文件
.DS_Store

# 构建产物（你是 backend，一般没有 dist，但写着无妨）
dist/
build/

# 临时文件
.cache/
tmp/
temp/

# Git 本身不需要被 COPY 进镜像
.git
.gitignore
.dockerignore

# 上传文件目录 —— 镜像不需要存你本地上传的文件
uploads/*

# 但保留目录结构
!uploads/.gitkeep
